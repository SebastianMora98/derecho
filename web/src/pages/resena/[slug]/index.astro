---
// La hoja de una sección del índice. Con un solo documento —el caso de casi
// todas— esta URL *es* la del documento; con dos o más pasa a ser la hoja donde
// se elige cuál abrir, y cada documento se publica un nivel más abajo.
//
// El desdoble está acá, en una ruta sola, por dos motivos. Uno: las secciones
// que ya tenían su documento en `/resena/<slug>/` no se mueven cuando alguna
// otra suma un segundo. Dos: `/resena/<slug-del-grupo>/` sigue siendo la única
// dirección que hay que saber, que es adonde llevan los diez clics de
// `tarjetas.js` — por eso ese archivo no se toca.
import Base from "../../../layouts/Base.astro";
import HojaDocumento from "../../../components/HojaDocumento.astro";
import { inline } from "../../../lib/md";
import { ruta, titulo as tituloDe, librosDe } from "../../../lib/grupos";
import type { Grupo } from "../../../lib/grupos";

export async function getStaticPaths() {
  const modulos = import.meta.glob("../../../data/*.json", { eager: true }) as Record<string, any>;
  const libros = Object.entries(modulos)
    .filter(([ruta]) => !ruta.endsWith("indice.json") && !ruta.endsWith("grupos.json"))
    .map(([, mod]) => mod.default ?? mod);
  const declarados = (await import("../../../data/grupos.json")).default as any[];
  // Solo las secciones que de verdad tienen algún documento: una sin ellos no
  // necesita hoja, y no habría adónde navegar.
  return declarados
    .filter((g) => g.documentos.length > 0)
    .map((g) => ({
      params: { slug: g.slug },
      props: { grupo: g, libros: librosDe(libros, g) },
    }));
}

const { grupo, libros } = Astro.props as { grupo: Grupo; libros: any[] };
const uno = grupo.documentos.length === 1 ? grupo.documentos[0] : null;
const migas = `<span>${grupo.nombre}</span>`;
---
{uno ? (
  <HojaDocumento grupo={grupo} documento={uno} libros={libros} />
) : (
  <Base titulo={`Documentos de ${grupo.nombre}`} migas={migas}>
    <div class="hoja">
      <h1>{grupo.nombre}</h1>
      <p class="ficha">
        Esta clase tiene {grupo.documentos.length} documentos propios. Elegí cuál abrir.
      </p>
      {/* Las mismas tarjetas del índice de libros (`.libros` > `.libro`): acá
          cada una es un documento de la clase en vez de una lectura. */}
      <div class="libros">
        {grupo.documentos.map((d) => (
          <a class="libro" href={ruta(grupo, d)}>
            <span class="titulo">{tituloDe(grupo, d)}</span>
            {d.bajada && <p class="extracto" set:html={inline(d.bajada)} />}
            <span class="pie">
              {/* Sin `.autor` delante, así que el `· ` de `.autor + .meta` no
                  aparece: la línea de pie queda con el tamaño solo. */}
              <span class="meta">{d.palabras} palabras</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </Base>
)}
